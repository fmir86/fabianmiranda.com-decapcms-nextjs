# Copy to .env.local and fill in. All values are optional for local development:
# the site builds and renders without them. Only the Alfred chat widget
# (/api/chat) and its conversation logging (/api/chat-log) need them.

# Google AI Studio API key used by the Alfred chat widget
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-key

# Supabase project used to log chat sessions (server-side only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Base URL used by next-sitemap when generating sitemap.xml
SITE_URL=https://example.com
